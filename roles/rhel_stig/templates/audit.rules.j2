# STIG Audit Rules
# Managed by Ansible - do not edit manually

# Delete all existing rules
-D

# Set buffer size
-b {{ stig_audit_backlog_limit }}

# Record failed file access attempts
-a always,exit -F arch=b64 -S open -F exit=-EACCES -F auid>=1000 -F auid!=4294967295 -k access
-a always,exit -F arch=b64 -S open -F exit=-EPERM -F auid>=1000 -F auid!=4294967295 -k access

# Record file deletions
-a always,exit -F arch=b64 -S unlink -S unlinkat -S rename -S renameat -F auid>=1000 -F auid!=4294967295 -k delete

# Record changes to authentication files
-w /etc/passwd -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/sudoers -p wa -k privileged

# Record login/logout events
-w /var/log/faillog -p wa -k logins
-w /var/log/lastlog -p wa -k logins

# Record sudo usage
-w /usr/bin/sudo -p x -k privileged

# Record SSH key usage
-w /etc/ssh/sshd_config -p wa -k sshd

# Make rules immutable - must reboot to change
-e 2
